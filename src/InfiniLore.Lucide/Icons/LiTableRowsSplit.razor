@namespace InfiniLore.Lucide
@inherits ComponentBase

<svg xmlns="http://www.w3.org/2000/svg"
     width="@Width"
     height="@Height"
     viewBox="0 0 24 24"
     fill="@Fill"
     stroke="@Stroke"
     stroke-width="@StrokeWidth"
