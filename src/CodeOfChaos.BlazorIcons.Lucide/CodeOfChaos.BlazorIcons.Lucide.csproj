<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <!-- Package metadata -->
        <PackageId>CodeOfChaos.BlazorIcons.Lucide</PackageId>
        <Version>1.14.0</Version>
        <Description>Use Lucide in your Blazor apps</Description>
        <Authors>CodeOfChaos, Lucide</Authors>
        
        <!-- Define a fallback if NODE_PATH isn't set -->
        <LucideIconNodes Condition=" '$(NODE_PATH)' != '' ">$(NODE_PATH)/lucide-static/icon-nodes.json</LucideIconNodes>
        <LucideIconNodes Condition=" '$(NODE_PATH)' == '' ">$(MSBuildProjectDirectory)/node_modules/lucide-static/icon-nodes.json</LucideIconNodes>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="CodeOfChaos.Extensions.DependencyInjection" />
        <PackageReference Include="JetBrains.Annotations" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\CodeOfChaos.BlazorIcons.Lucide.SourceGenerators\CodeOfChaos.BlazorIcons.Lucide.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup Label="Lucide Files">
        <!-- Adjusted to ensure paths resolve dynamically -->
<!--        <AdditionalFiles Include="$(LucideIconsPath)" Link="Icons\%(RecursiveDir)%(FileName)%(Extension)" Pack="false" />-->
        <AdditionalFiles Include="$(LucideIconNodes)" Link="%(FileName)%(Extension)" Pack="false" />
    </ItemGroup>

    <ItemGroup Label="Packing">
        <!-- Exclude additional files from NuGet package -->
        <None Include="node_modules/lucide-static/icons/**/*.svg" Pack="false" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Properties\launchSettings.json" />
    </ItemGroup>

</Project>
